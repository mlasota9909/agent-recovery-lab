# Site configuration is private; the shared template is versioned.
/etc/lab.local.env

# Run outputs. Only directory markers and the model-set template are versioned.
/evidence/*
!/evidence/.gitkeep
/archive/*
!/archive/.gitkeep
/results/*
!/results/.gitkeep
/logs/*
!/logs/.gitkeep
/var/*
!/var/.gitkeep
/runtime/*
!/runtime/.gitkeep
/basebackup/*
!/basebackup/.gitkeep
/analysis-out/*
!/analysis-out/.gitkeep
!/runtime/p9-model-set.json
/backups/
/incidents/scaled/
__pycache__/
*.pyc
*.tar.gz
*.zip
*id_ed25519*
*.pem
*.key
.pgpass
wal_append_ed25519*
