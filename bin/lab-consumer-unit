#!/usr/bin/env python3
"""Print the consumer service with paths and owner from this checkout."""
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))
from lab_config import load_env


def systemd_quote(value: str, command: bool = False) -> str:
    if command:
        value = value.replace("$", "$$")
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"').replace("%", "%%") + '"'


def systemd_path(value: str) -> str:
    """WorkingDirectory= takes an unquoted absolute path; only % needs escaping."""
    if not value.startswith("/") or any(ord(c) < 32 for c in value) or value != value.rstrip():
        raise SystemExit(f"lab-consumer-unit: checkout path must be absolute, without control characters or trailing space: {value!r}")
    return value.replace("%", "%%")


def systemd_user(value: str) -> str:
    """User= takes an unquoted user name."""
    if not re.fullmatch(r"[a-z_][a-z0-9_-]*[$]?", value or ""):
        raise SystemExit(f"lab-consumer-unit: HOST_ARCHIVE_USER is not a valid user name: {value!r}")
    return value


def main() -> int:
    if len(sys.argv) != 1:
        print("usage: lab-consumer-unit", file=sys.stderr)
        return 3
    config = load_env(ROOT)
    unit = (ROOT / "etc/systemd/lab-consumer@.service").read_text()
    unit = unit.replace("@LAB_ROOT@", systemd_path(str(ROOT)))
    unit = unit.replace("@LAB_USER@", systemd_user(config["HOST_ARCHIVE_USER"]))
    unit = unit.replace("@LAB_CONSUMER@", systemd_quote(str(ROOT / "bin/lab-consumer"), command=True))
    print(unit, end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
