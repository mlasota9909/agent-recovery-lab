#!/usr/bin/env bash
# C004: filesystem diff + tree hasher. Stock zfs diff and .zfs/snapshot/ only.
set -euo pipefail
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
# shellcheck source=/dev/null
set -a
source "$ROOT/etc/lab.env"
set +a
source "$ROOT/lib/lab_incident_env.sh"
export PYTHONPATH="$ROOT/lib${PYTHONPATH:+:$PYTHONPATH}"
exec python3 "$ROOT/lib/lab_fs_capture.py" "$@"
