#!/usr/bin/env python3
"""Print a restricted authorized_keys entry for this checkout's WAL receiver."""
import argparse
import base64
import binascii
import shlex
import sys
from pathlib import Path


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("public_key", nargs="?", type=Path, help="public key file (default: stdin)")
    args = parser.parse_args()
    raw = args.public_key.read_text() if args.public_key else sys.stdin.read()
    rows = raw.strip().splitlines()
    if len(rows) != 1:
        parser.error("expected one public key")
    parts = rows[0].split(None, 2)
    if len(parts) < 2 or not parts[0].startswith(("ssh-", "ecdsa-", "sk-")):
        parser.error("expected a public key without authorized_keys options")
    try:
        decoded = base64.b64decode(parts[1], validate=True)
        length = int.from_bytes(decoded[:4], "big")
        if decoded[4:4 + length].decode("ascii") != parts[0] or len(decoded) <= 4 + length:
            raise ValueError("key type mismatch")
    except (binascii.Error, ValueError, UnicodeError):
        parser.error("invalid public key encoding")
    receiver = Path(__file__).resolve().parents[1] / "bin/lab-wal-receive"
    command = shlex.quote(str(receiver)).replace("\\", "\\\\").replace('"', '\\"')
    options = f'command="{command}",no-port-forwarding,no-X11-forwarding,no-agent-forwarding,no-pty'
    print(options + " " + " ".join(parts))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
