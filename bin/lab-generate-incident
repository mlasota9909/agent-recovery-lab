#!/usr/bin/env bash
# W008: phase 1 — generate a frozen SC-01 incident.
set -euo pipefail
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
# shellcheck source=/dev/null
source "$ROOT/etc/lab.env"
export LAB_ROOT EVIDENCE_ROOT ARCHIVE_CURRENT ARCHIVE_ROOT RESULTS_ROOT
export VM_SSH PG_DATA PG_VERSION PG_PORT DB_NAME
export SC01_BASELINE_S SC01_TPS SC01_MIX SC01_INJECT_ROWS
export PYTHONPATH="$ROOT/lib${PYTHONPATH:+:$PYTHONPATH}"
exec python3 "$ROOT/lib/lab_generate_incident.py" "$@"
