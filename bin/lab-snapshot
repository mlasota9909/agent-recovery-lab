#!/usr/bin/env bash
# Create a labelled snapshot through the incident's serialized writer.
set -euo pipefail
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
set -a
source "$ROOT/etc/lab.env"
set +a
export PYTHONPATH="$ROOT/lib${PYTHONPATH:+:$PYTHONPATH}"
exec python3 "$ROOT/lib/lab_snapshot_tick.py" "$@"
