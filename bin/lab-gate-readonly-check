#!/usr/bin/env bash
# Z002: before/after SHA-256 manifest of the evidence root. Writes only under logs/review/.
set -euo pipefail
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
# shellcheck source=/dev/null
set -a
source "$ROOT/etc/lab.env"
set +a
export PYTHONPATH="$ROOT/lib${PYTHONPATH:+:$PYTHONPATH}"
exec python3 "$ROOT/lib/lab_gate_readonly.py" "$@"
