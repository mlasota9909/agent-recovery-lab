#!/usr/bin/env bash
# C006: no-ETL DuckDB view layer over the incident ledger.
set -euo pipefail
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
# shellcheck source=/dev/null
set -a
source "$ROOT/etc/lab.env"
set +a
export PYTHONPATH="$ROOT/lib${PYTHONPATH:+:$PYTHONPATH}"
exec python3 "$ROOT/lib/lab_query.py" "$@"
