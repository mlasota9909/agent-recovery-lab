#!/usr/bin/env bash
# W004: ledger integrity. JSON on stdout.
set -euo pipefail
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
# shellcheck source=/dev/null
source "$ROOT/etc/lab.env"
export LAB_ROOT EVIDENCE_ROOT
export PYTHONPATH="$ROOT/lib${PYTHONPATH:+:$PYTHONPATH}"
exec python3 "$ROOT/lib/lab_ledger_verify.py" "$@"
