{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 5242880
  },
  "output": {
    "filePath": "backups/repomix-latest.md",
    "style": "markdown",
    "headerText": "Lab backup (tranche-neutral, P0..P10). Specs, CLIs, lib/, sql/, contracts, review bundles, lab.env, architecture handoffs, vendor tokenizer, P9/P10 sweep sidecars. WAL archive, evidence jsonl, banked results jsonl, padded-incident bulk ledgers, secrets excluded.",
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": false,
    "copyToClipboard": false,
    "topFilesLength": 20
  },
  "include": [
    "sdd/**",
    "bin/**",
    "lib/**",
    "sql/**",
    "etc/**",
    "docs/**",
    "logs/review/**/*.md",
    "logs/review/R*/**/*.json",
    "logs/review/W*/**/*.json",
    "logs/review/T011/final-gap.json",
    "logs/review/W*/**/*.txt",
    "logs/review/W*/**/*.log",
    "logs/review/C*/**/*.json",
    "logs/review/C*/**/*.log",
    "logs/review/C*/**/*.txt",
    "logs/review/C*/**/*.md",
    "logs/review/D*/**/*.json",
    "logs/review/D*/**/*.log",
    "logs/review/D*/**/*.txt",
    "logs/review/Y*/**/*.json",
    "logs/review/Y*/**/*.txt",
    "logs/review/Z*/**/*.md",
    "logs/review/Z*/**/*.json",
    "logs/review/Z*/**/*.txt",
    "logs/review/E*/**/*.md",
    "logs/review/E*/**/*.json",
    "logs/review/E*/**/*.txt",
    "logs/review/F*/**/*.md",
    "logs/review/F*/**/*.json",
    "logs/review/F*/**/*.txt",
    "logs/review/G*/**/*.md",
    "logs/review/G*/**/*.json",
    "logs/review/G*/**/*.txt",
    "logs/review/G*/**/*.out",
    "logs/review/H*/**/*.md",
    "logs/review/H*/**/*.json",
    "logs/review/H*/**/*.txt",
    "logs/review/H*/**/*.out",
    "logs/review/J*/**/*.md",
    "logs/review/J*/**/*.json",
    "logs/review/J*/**/*.txt",
    "logs/review/J*/**/*.out",
    "logs/review/J*/**/*.completion",
    "logs/review/K*/**/*.md",
    "logs/review/K*/**/*.json",
    "logs/review/K*/**/*.txt",
    "logs/review/K*/**/*.out",
    "logs/review/K*/**/*.log",
    "scenarios/**",
    "logs/review/H*/**/completions/**",
    "logs/review/N*/**/*.md",
    "logs/review/N*/**/*.json",
    "logs/review/N*/**/*.txt",
    "fixtures/regression/**/provenance.json",
    "results/fixtures/MANIFEST.md",
    "results/sweep-runs.jsonl",
    "evidence/README-evidence.md",
    ".gitignore",
    "logs/review/Q*/**/*.md",
    "logs/review/Q*/**/*.json",
    "logs/review/Q*/**/*.txt",
    "logs/review/Q*/**/*.log",
    "logs/review/P10/**/*.md",
    "results/scaling-runs.jsonl",
    "results/scaling-runs-detail.jsonl",
    "results/scaling-runs-exploratory.jsonl",
    "results/scaling-runs-exploratory.v1.jsonl",
    "runtime/**",
    "incidents/scaled/*/generator-record.json",
    "README.md"
  ],
  "ignore": {
    "useGitignore": false,
    "useDefaultPatterns": false,
    "customPatterns": [
      "archive/**",
      "basebackup/**",
      "results/SC-0*.jsonl",
      "results/matrix.jsonl",
      "results/fixtures/*.jsonl",
      "backups/**",
      "**/__pycache__/**",
      "**/*.pyc",
      "**/*.tar.gz",
      "**/*id_ed25519*",
      "**/*.pem",
      "**/*.key",
      "**/.pgpass",
      "**/wal_append_ed25519*",
      "logs/review/**/heartbeat-window.json",
      "logs/review/**/verify-results.json",
      "logs/review/**/regression-idempotent.json",
      "logs/review/**/commands.log",
      "logs/review/W008/analysis-view*.json",
      "logs/review/X001/db.jsonl.after-catchup",
      "logs/review/X001/db.jsonl.frozen",
      "logs/review/Q*/scratch/**",
      "incidents/scaled/_neg/**"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
