# SC-01 scenario config. Declared parameters — not fitted to a headline result (ADR-P3-3, ADR-P3-4).
SC01_RELATIONS=p2_probe
SC01_RELATION=p2_probe
SC01_SEED_KEY_MIN=1
SC01_SEED_KEY_MAX=400
SC01_INJECT_ROWS=200
SC01_WINDOW_S=2
SC01_BASELINE_S=10
SC01_AFTER_INJECT_S=4
SC01_WORKLOAD_SEED=7
SC01_WORKLOAD_TPS=8
SC01_ANALYTICS_VERSION=p3-analytics-1
# Operator-approximate incident time is taken from the pre_injection snapshot wall-clock.
# Declared fixed error: operators commonly report the event tens of seconds late.
# This value is not tuned against Arm A (ADR-P3-3).
SC01_NAIVE_TIME_ERROR_SECONDS=20
SC01_NAIVE_SELECTOR_VERSION=p3-naive-1
SC01_ORACLE_DAMAGE_CLASS="database data"
SC01_ORACLE_TIMING_PATTERN="near-instant"
