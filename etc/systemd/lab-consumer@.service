# Render with bin/lab-consumer-unit before installation.
[Unit]
Description=Lab logical decoding consumer for incident %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@LAB_USER@
WorkingDirectory=@LAB_ROOT@
ExecStart=@LAB_CONSUMER@ run %i
Restart=always
RestartSec=3
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
